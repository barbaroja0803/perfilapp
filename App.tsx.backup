      <main className="max-w-7xl mx-auto px-6 pt-32 pb-32">
        
        {/* Hero Section - Cyberpunk Style */}
        <section className={`mb-40 grid lg:grid-cols-12 gap-12 items-center transition-all duration-1000 ${isVisible ? 'opacity-100 translate-y-0' : 'opacity-0 translate-y-10'}`}>

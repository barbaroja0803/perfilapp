          </div>
        </section>

        {/* Skills - Neon Cards */}
        <section id="skills" className="mb-40 parallax">
          <div className="section-tag mb-12">
            <span className="text-cyan-400">SYSTEM_MODULES</span> <span className="text-purple-400">(CAPABILITIES)</span>
          </div>
          <div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {SKILLS.map((skill, idx) => (

            <div className="inline-block px-4 py-1.5 rounded-full bg-cyan-500/10 border-2 border-cyan-500/30 text-cyan-400 font-mono text-[11px] uppercase tracking-widest hover:bg-cyan-500/20 hover:scale-105 transition-all cursor-default ripple"
                 style={{boxShadow: '0 0 20px rgba(0, 243, 255, 0.3)'}}>

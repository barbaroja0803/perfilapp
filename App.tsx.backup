                   <span className="text-pink-400">&gt;</span> sys.identity: <span className="text-white">Junior_W_Anchundia</span><br/>
                   <span className="text-pink-400">&gt;</span> role: <span className="text-purple-400">Sr_Engineer</span>, <span className="text-cyan-400">Cloud_Ops</span><br/>
                   <span className="text-pink-400">&gt;</span> status: <span className="text-green-400 animate-pulse">● ACTIVE</span> | Freelance<br/>
                </div>

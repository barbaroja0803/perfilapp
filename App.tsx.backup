            <div className="hidden sm:block h-4 w-px bg-purple-500/50"></div>
            <span className="hidden sm:block text-[10px] font-mono text-purple-400 uppercase tracking-widest">
              v2.077_CYBERPUNK_BUILD
            </span>
          </div>
          <div className="flex gap-4">
             <div className="flex flex-col items-end">
                <span className="text-[9px] font-mono text-pink-500 uppercase">NEURAL_LOAD</span>
                <div className="flex gap-1">
                   {[...Array(5)].map((_, i) => (
                     <div 
                       key={i} 
                       className="w-3 h-1 bg-gradient-to-r from-cyan-500 to-purple-500"
                       style={{
                         animation: `neonPulse 1.5s ease-in-out infinite`,
                         animationDelay: `${i * 0.15}s`,
                         boxShadow: '0 0 5px currentColor'
                       }}
                     ></div>
                   ))}
                </div>
             </div>
          </div>
        </div>

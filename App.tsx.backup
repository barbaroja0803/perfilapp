               <div className="px-4 py-2 bg-gradient-to-r from-purple-500/10 to-transparent border-l-2 border-purple-400 text-purple-400 hover:bg-purple-500/20 transition-all hover-lift cursor-default"
                    style={{boxShadow: '0 0 10px rgba(168, 85, 247, 0.2)'}}>
